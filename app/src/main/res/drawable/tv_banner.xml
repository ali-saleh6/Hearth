<?xml version="1.0" encoding="utf-8"?>
<!-- Leanback launcher banner (320x180). Mascot centred on the icon background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/mascot_icon_background" />
    <item
        android:width="112dp"
        android:height="112dp"
        android:gravity="center">
        <bitmap android:src="@drawable/hearth_mascot" android:gravity="fill" />
    </item>
</layer-list>
